# PaceForge-Backend – Umgebungsvariablen (Beispiel). Nichts hiervon committen.

# Port (Default 8787; Render setzt PORT automatisch).
# PORT=8787

# Optional: aktiviert die LLM-gestützte Zieleingabe (claude-opus-4-8).
# Ohne Key nutzt /api/parse-goal den deterministischen Regel-Parser.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional (Phase 2): offizielle Garmin Training API (OAuth).
# Ohne diese Werte liefern die /api/garmin/*-Routen 501.
# GARMIN_CLIENT_ID=...
# GARMIN_CLIENT_SECRET=...
