# PaceForge-Backend – Umgebungsvariablen (Beispiel). Nichts hiervon committen.

# Port (Default 8787; Render setzt PORT automatisch).
# PORT=8787

# Optional: aktiviert die LLM-gestützte Zieleingabe (claude-opus-4-8).
# Ohne Key nutzt /api/parse-goal den deterministischen Regel-Parser.
# ANTHROPIC_API_KEY=sk-ant-...

# Nötig für die inoffizielle Garmin-Connect-Anbindung (verschlüsselt die gespeicherten
# Session-Tokens, AES-256-GCM). Ohne diesen Wert liefert /api/garmin/login 503.
# Zufälligen, langen String setzen, z.B. `openssl rand -hex 32`.
# GARMIN_TOKEN_ENCRYPTION_KEY=...

# Optional: dauerhafte Ablage für Cross-Device-Sync-Snapshots via Upstash Redis
# (REST-API, kostenloses Tier reicht). Ohne diese Werte liegen Snapshots nur im
# Arbeitsspeicher und sind nach jedem Neustart/Deploy weg.
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
