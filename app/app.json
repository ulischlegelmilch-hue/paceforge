{
  "expo": {
    "name": "PaceForge",
    "slug": "paceforge",
    "owner": "hag1711",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "paceforge",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/2502d7aa-cfc7-4a13-85d0-f6aa870321f4"
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.paceforge.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0e1116",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#C97A3E"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PaceForge nutzt deinen Standort, um während des Wettkampf-Audioguides deine gelaufene Distanz zu tracken.",
          "locationAlwaysAndWhenInUsePermission": "PaceForge nutzt deinen Standort auch bei gesperrtem Bildschirm, damit der Wettkampf-Audioguide dich weiter per Ansage begleitet, wenn das Handy in der Tasche steckt.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2502d7aa-cfc7-4a13-85d0-f6aa870321f4"
      }
    }
  }
}
